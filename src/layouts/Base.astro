---
import { ClientRouter } from 'astro:transitions';
import '../styles/base.css';
import Meta from '../components/Meta.astro';
import EdgeNav from '../components/EdgeNav.astro';
import Field from '../components/Field.astro';

interface Props {
  title?: string;
  description?: string;
  /** A picture behind the darkness, revealed by the light. Path under /public. */
  texture?: string;
  /** How hard the light runs, 0–1. Reading pages turn it down. */
  intensity?: number;
}

const { title, description, texture, intensity = 0.42 }: Props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#050505" />

    <!--
      Marks the document as scripted, before first paint.

      Everything that starts hidden and is revealed by JavaScript is gated
      on html.js. So if scripts are blocked, fail to load, or throw, the
      page falls back to showing all of its content rather than to a wall of
      empty rectangles. This must stay inline and in <head> to avoid a flash.
    -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <Meta title={title} description={description} />

    <!--
      Navigation is a scan pass: the router swaps the document while the
      field, which persists, runs its bar down the page and writes the new
      picture in behind it.
    -->
    <ClientRouter />

    <!--
      The field persists across navigations, so its own attributes are always
      the ones it started with. These travel with the document instead, and
      are what the router hands to the machine on each swap.
    -->
    <meta name="scan-texture" content={texture} />
    <meta name="scan-intensity" content={String(intensity)} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!--
      Both faces are needed above the fold — the sans for her name, the mono
      for every readout — so both are preloaded rather than discovered.
    -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/geist-latin-wght-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/geist-mono-latin-wght-normal.woff2"
      crossorigin
    />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <Field texture={texture} intensity={intensity} />

    <main id="main" class="page">
      <slot />
    </main>

    <EdgeNav />
  </body>
</html>
