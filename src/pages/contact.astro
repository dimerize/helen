---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

/*
  One plate on the glass, with registration marks at its corners that strike
  once on arrival.

  There are no field labels: an envelope next to an address that has an @ and
  a .com is an email, and a camera next to a handle beginning with @ is
  Instagram. Screen readers get the labels through visually-hidden text, so
  nothing is lost by not printing them.

  Where she is comes from the running local clock rather than the words
  "based in New York".
*/
---

<Base
  title="Contact"
  description={`Contact ${site.name}. Enquiries, collaboration and studio visits.`}
  texture="/textures/t-04.jpg"
>
  <h1 class="sr">Contact {site.name}</h1>

  <div class="contact">
    <div class="hang" aria-hidden="true"></div>

    <article class="card">
    <svg class="card__mark card__mark--tl" viewBox="0 0 10 10" aria-hidden="true"
      ><path d="M0 0h10M0 0v10" /></svg
    >
    <svg class="card__mark card__mark--tr" viewBox="0 0 10 10" aria-hidden="true"
      ><path d="M10 0H0M10 0v10" /></svg
    >
    <svg class="card__mark card__mark--bl" viewBox="0 0 10 10" aria-hidden="true"
      ><path d="M0 10h10M0 10V0" /></svg
    >
    <svg class="card__mark card__mark--br" viewBox="0 0 10 10" aria-hidden="true"
      ><path d="M10 10H0M10 10V0" /></svg
    >

    <p class="card__name">{site.name}</p>

    <ul class="card__links">
      <li>
        <a class="card__link" href={`mailto:${site.email}`}>
          <svg class="card__icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="2.5" y="5" width="19" height="14" rx="1.5" />
            <path d="M3 6.5 12 13l9-6.5" />
          </svg>
          <span class="sr">Email. </span>{site.email}
        </a>
      </li>
      <li>
        <a class="card__link" href={site.instagramUrl} rel="me noopener">
          <svg class="card__icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.2" cy="6.8" r="1.05" fill="currentColor" stroke="none" />
          </svg>
          <span class="sr">Instagram. </span>@{site.instagram}
        </a>
      </li>
    </ul>

    <p class="card__clock meta">
      <span class="sr">Local time in {site.location}: </span>
        <time data-clock data-tz={site.timeZone}></time>
      </p>
    </article>
  </div>
</Base>

<script>
  import '../lib/clock.ts';
</script>

<style>
  /* Fills the page so the card hangs in the middle of the wall. */
  .contact {
    position: relative;
    flex: 1;
    display: grid;
    place-content: center;
    justify-items: center;
  }

  /* The same hanging line as the entry page and the wall, run through her. */
  .hang {
    position: absolute;
    left: calc(var(--edge) * -1);
    right: calc(var(--edge) * -1);
    top: 50%;
    height: 1px;
    background: var(--line-faint);
  }

  .card {
    position: relative;
    width: min(26rem, 100%);
    padding: clamp(1.75rem, 5vw, 2.5rem);
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.012);
  }

  .card__name {
    font-size: var(--t-title);
    letter-spacing: var(--track-title);
    text-transform: uppercase;
    color: var(--ink);
  }

  .card__links {
    display: grid;
    gap: 0.15rem;
    margin-top: 1.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line-faint);
  }

  /* Line-drawn to match the registration marks, not a filled glyph set. */
  .card__icon {
    flex: none;
    width: 17px;
    height: 17px;
    color: var(--ink-faint);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    transition: color var(--dur-quick) var(--ease-out);
  }

  .card__link:hover .card__icon,
  .card__link:focus-visible .card__icon {
    color: var(--ink);
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 44px;
    font-size: var(--t-body);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
    transition: text-decoration-color var(--dur-quick) var(--ease-out);
  }

  .card__link:hover,
  .card__link:focus-visible {
    text-decoration-color: var(--line-strong);
  }

  .card__clock {
    margin-top: 1.4rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-faint);
    color: var(--ink-faint);
    /* Filled in by JavaScript; hidden entirely without it. */
    display: none;
  }

  :global(html.js) .card__clock {
    display: block;
  }

  .card__mark {
    position: absolute;
    width: 9px;
    height: 9px;
    color: var(--ink-faint);
    overflow: visible;
    /*
      Registration, once, on arrival — the same alignment every work makes.
      Under reduced motion this lands immediately on its resting colour.
    */
    animation: register 1800ms var(--ease-out) 350ms both;
  }

  .card__mark path {
    stroke: currentColor;
    stroke-width: 1.5;
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .card__mark--tl { top: -5px; left: -5px; }
  .card__mark--tr { top: -5px; right: -5px; }
  .card__mark--bl { bottom: -5px; left: -5px; }
  .card__mark--br { bottom: -5px; right: -5px; }

  @keyframes register {
    0% {
      opacity: 0;
      color: var(--signal);
    }
    25% {
      opacity: 1;
      color: var(--signal);
    }
    55% {
      opacity: 1;
      color: var(--signal);
    }
    100% {
      opacity: 1;
      color: var(--ink-faint);
    }
  }
</style>
