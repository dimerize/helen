---
import Base from '../layouts/Base.astro';
import Wall from '../components/Wall.astro';
import { site, HANGING_LINE_INCHES } from '../data/site';

/*
  Entry.

  A picture hanging in a dark room. The lamp drifts across it so a little is
  always surfacing somewhere, and moving a cursor or a finger across the
  wall uncovers the rest, which then sinks back as the trace decays.

  There is no caption telling anyone to do this. The light is already
  moving when the page loads, and it follows the pointer on first contact,
  which is the whole instruction.

  Below the fold, the wall itself — so scrolling goes somewhere.
*/
---

<Base field="live" texture="/textures/entry.jpg">
  <div class="entry">
    <div class="entry__id">
      <h1 class="entry__name">{site.name}</h1>
      <p class="entry__coords meta">
        <span class="sr">Based in {site.location}. Coordinates: </span>
        {site.coordinates.lat}<span class="entry__gap"></span>{site.coordinates.lon}
      </p>
    </div>

    <div class="entry__line">
      <span class="sr">Gallery hanging line, {HANGING_LINE_INCHES} inches to centre.</span>
      <span class="entry__gauge meta" aria-hidden="true">{HANGING_LINE_INCHES}&#8221; center</span>
    </div>

    <!--
      No label. The navigation directly below already says Works, and two
      of them stacked read as a mistake. A falling line against the hanging
      line is unambiguous on its own.
    -->
    <a class="entry__down" href="#works">
      <span class="sr">Go to works</span>
      <span class="entry__arrow" aria-hidden="true"></span>
    </a>
  </div>

  <Wall />
</Base>

<style>
  /* The entry holds the viewport exactly; the wall begins under it. */
  .entry {
    position: relative;
    min-height: calc(100dvh - var(--edge) * 2);
    display: grid;
    align-content: space-between;
  }

  .entry__id {
    padding-top: clamp(1rem, 8vh, 5rem);
  }

  .entry__name {
    font-size: clamp(1rem, 0.9rem + 0.55vw, 1.25rem);
    font-weight: 400;
    letter-spacing: var(--track-title);
    text-transform: uppercase;
    color: var(--ink);
  }

  .entry__coords {
    margin-top: 0.7rem;
    color: var(--ink-faint);
  }

  .entry__gap {
    display: inline-block;
    width: 1.5em;
  }

  /*
    57% down the viewport. The number is a coincidence worth keeping: the
    hanging line is 57 inches, and this sits at 57% of the field.

    The line is pulled --edge beyond the page on both sides so it runs full
    bleed, which means anything positioned inside it needs twice --edge to
    sit on the page's text margin rather than on the glass.
  */
  .entry__line {
    position: absolute;
    left: calc(var(--edge) * -1);
    right: calc(var(--edge) * -1);
    top: 57%;
    height: 1px;
    background: var(--line);
  }

  .entry__line::before,
  .entry__line::after {
    content: '';
    position: absolute;
    top: -4px;
    width: 1px;
    height: 9px;
    background: var(--line-strong);
  }

  .entry__line::before {
    left: calc(var(--edge) * 2);
  }

  .entry__line::after {
    right: calc(var(--edge) * 2);
  }

  .entry__gauge {
    position: absolute;
    right: calc(var(--edge) * 2);
    bottom: 0.65rem;
    color: var(--ink-faint);
  }

  /* The way in. Small, but unmistakably a control, and it moves. */
  .entry__down {
    justify-self: start;
    display: inline-flex;
    align-items: flex-end;
    /* Clear of the fixed navigation, which sits over the bottom edge. */
    padding-bottom: calc(var(--nav-h) + 0.75rem);
    min-width: 44px;
    color: var(--ink-muted);
    transition: color var(--dur-quick) var(--ease-out);
  }

  .entry__down:hover,
  .entry__down:focus-visible {
    color: var(--ink);
  }

  .entry__arrow {
    width: 1px;
    height: 26px;
    background: currentColor;
    transform-origin: top center;
    animation: drop 2600ms var(--ease-out) infinite;
  }

  @keyframes drop {
    0%,
    100% {
      transform: scaleY(0.35);
      opacity: 0.35;
    }
    45% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry__arrow {
      animation: none;
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @media (max-width: 30rem) {
    .entry__gauge {
      font-size: 0.625rem;
    }
  }
</style>
