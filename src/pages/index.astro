---
import Base from '../layouts/Base.astro';
import { site, HANGING_LINE_INCHES } from '../data/site';

/*
  Entry.

  A picture hanging in a dark room. A scan bar travels up and down the wall
  and lights it as it passes; moving a cursor or a finger uncovers the rest,
  which then sinks back as the trace decays.

  There is no caption telling anyone to do this. The bar is already moving
  when the page loads, and the light follows the pointer on first contact,
  which is the whole instruction.
*/
---

<Base field="live" texture="/textures/entry.jpg">
  <div class="entry">
    <div class="entry__id">
      <h1 class="entry__name">{site.name}</h1>
      <p class="entry__coords meta">
        <span class="sr">Based in {site.location}. Coordinates: </span>
        {site.coordinates.lat}<span class="entry__gap"></span>{site.coordinates.lon}
      </p>
    </div>

    <div class="entry__line">
      <span class="sr">Gallery hanging line, {HANGING_LINE_INCHES} inches to centre.</span>
      <span class="entry__gauge meta" aria-hidden="true">{HANGING_LINE_INCHES}&#8221; center</span>
    </div>
  </div>
</Base>

<style>
  /* One viewport. Nothing below it. */
  .entry {
    position: relative;
    min-height: calc(100dvh - var(--edge) * 2 - var(--nav-h));
  }

  .entry__id {
    padding-top: clamp(1rem, 8vh, 5rem);
  }

  .entry__name {
    font-size: clamp(1rem, 0.9rem + 0.55vw, 1.25rem);
    font-weight: 400;
    letter-spacing: var(--track-title);
    text-transform: uppercase;
    color: var(--ink);
  }

  .entry__coords {
    margin-top: 0.7rem;
    color: var(--ink-faint);
  }

  .entry__gap {
    display: inline-block;
    width: 1.5em;
  }

  /*
    57% down the viewport. The number is a coincidence worth keeping: the
    hanging line is 57 inches, and this sits at 57% of the field.

    The line is pulled --edge beyond the page on both sides so it runs full
    bleed, which means anything positioned inside it needs twice --edge to
    sit on the page's text margin rather than on the glass.
  */
  .entry__line {
    position: absolute;
    left: calc(var(--edge) * -1);
    right: calc(var(--edge) * -1);
    top: 57%;
    height: 1px;
    background: var(--line);
  }

  .entry__line::before,
  .entry__line::after {
    content: '';
    position: absolute;
    top: -4px;
    width: 1px;
    height: 9px;
    background: var(--line-strong);
  }

  .entry__line::before {
    left: calc(var(--edge) * 2);
  }

  .entry__line::after {
    right: calc(var(--edge) * 2);
  }

  .entry__gauge {
    position: absolute;
    right: calc(var(--edge) * 2);
    bottom: 0.65rem;
    color: var(--ink-faint);
  }

  @media (max-width: 30rem) {
    .entry__gauge {
      font-size: 0.625rem;
    }
  }
</style>
