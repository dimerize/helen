---
import Base from '../layouts/Base.astro';

/*
  Not found, in the register of the rest of the site: a placement that has
  no work in it. Honest about what happened, and one clear way back.
*/
---

<Base title="Not found" description="This page does not exist." texture="/textures/t-02.jpg">
  <div class="nf">
    <p class="meta nf__code">404</p>
    <h1 class="nf__title">Nothing on the glass</h1>
    <p class="nf__body prose">There is no page at this address.</p>
    <p class="meta nf__back">
      <a class="u tap" href="/">Home</a>
      <span aria-hidden="true"> · </span>
      <a class="u tap" href="/archive">Archive</a>
      <span aria-hidden="true"> · </span>
      <a class="u tap" href="/gallery">Gallery</a>
    </p>
  </div>
</Base>

<style>
  .nf {
    display: grid;
    gap: 0.9rem;
    align-content: center;
    justify-items: start;
    min-height: 60vh;
    max-width: var(--measure);
  }

  .nf__code {
    color: var(--ink-faint);
  }

  .nf__title {
    font-size: var(--t-lead);
    font-weight: 400;
    color: var(--ink);
  }

  .nf__body {
    color: var(--ink-muted);
  }

  .nf__back {
    margin-top: 1.25rem;
  }
</style>
