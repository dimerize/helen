---
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title, description = site.meta.description, ogImage = '/og-default.jpg' } = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : site.meta.title;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
const isStudioPage = ['/', '/work', '/archive', '/project', '/gallery'].includes(path);
const ogUrl = new URL(ogImage, Astro.site).href;

/*
  Structured data. Every claim here is drawn from the profile Helen supplied
  — nothing about exhibitions, awards or representation is asserted.
*/
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: new URL('/', Astro.site).href,
  jobTitle: 'Artist',
  address: { '@type': 'PostalAddress', addressLocality: 'New York', addressCountry: 'US' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Parsons School of Design, The New School' },
  sameAs: [site.instagramUrl],
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{isStudioPage && <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Red and white train signage scanned by Helen Zhang." />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
