---
import { site } from '../data/site';

/*
  One footer for every studio page: Helen's name on the left, then the city
  and two ways to reach her. It mirrors the shared header, so it sits on the
  same gutters and speaks in the same voice on every page.

  A page may keep one link of its own beside the name: Selected Works keeps
  "Enter the archive", project pages keep "Back to top".

  Colours come from the page around it. A page sets --footer-ink,
  --footer-quiet, --footer-rule and --footer-hover; without them the footer
  suits the dark homepage. Styles live in public/studio/shared.css.
*/

interface Props {
  /** One extra link beside the name. */
  link?: { href: string; label: string; icon: 'arrow-up' | 'arrow-up-right' };
}

const { link } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer-start">
    <a class="site-footer-name" href="/">{site.name}</a>
    {
      link && (
        <a class="site-footer-link" href={link.href}>
          {link.label} <span class={`ui-icon icon-${link.icon}`} aria-hidden="true" />
        </a>
      )
    }
  </div>
  <address class="site-footer-contact">
    <span class="site-footer-city">{site.city}</span>
    <a class="site-footer-icon" href={`mailto:${site.email}`} aria-label="Email Helen">
      <svg viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="6" width="20" height="14" rx="1" /><path d="M3.5 7l9.5 7.5L22.5 7" /></svg>
    </a>
    <a class="site-footer-icon" href={site.instagramUrl} aria-label={`${site.name} on Instagram`}>
      <svg viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="4" y="4" width="18" height="18" rx="5.5" /><circle cx="13" cy="13" r="4.2" /><circle cx="18.2" cy="7.8" r=".9" fill="currentColor" stroke="none" /></svg>
    </a>
  </address>
</footer>
