---
/*
  The stencil marks that go on the outside of a crate: this way up, fragile,
  keep dry. Drawn as plain white line work, at the size they would be
  printed, and used once per work page rather than scattered about.

  They are the reason this vocabulary is worth using at all: an artwork is
  not only an image. It has weight, a right way up, and a set of conditions
  under which it survives being moved.
*/

interface Props {
  class?: string;
}

const { class: className }: Props = Astro.props;

const marks = [
  {
    label: 'This way up',
    path: 'M7 21V5M7 5 3.6 9M7 5l3.4 4M17 21V5M17 5l-3.4 4M17 5l3.4 4M2 24h20',
  },
  {
    label: 'Fragile',
    path: 'M8 3h8l-2.4 10.5h-3.2zM12 13.5V21M8.6 21h6.8',
  },
  {
    label: 'Keep dry',
    path: 'M3.5 14a8.5 8.5 0 0 1 17 0zM12 14v6.2a2 2 0 0 0 3.4 1.2M8 4.2 8.9 6M12 2.6v2M16 4.2 15.1 6',
  },
];
---

<ul class:list={['marks', className]}>
  {
    marks.map((mark) => (
      <li class="marks__item">
        <svg viewBox="0 0 24 25" class="marks__svg" role="img" aria-label={mark.label}>
          <path d={mark.path} />
        </svg>
        <span class="meta marks__label">{mark.label}</span>
      </li>
    ))
  }
</ul>

<style>
  .marks {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 5vw, 2.75rem);
  }

  .marks__item {
    display: grid;
    justify-items: start;
    gap: 0.6rem;
  }

  .marks__svg {
    width: 22px;
    height: auto;
    overflow: visible;
  }

  .marks__svg path {
    stroke: var(--ink-muted);
    stroke-width: 1.25;
    stroke-linecap: square;
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .marks__label {
    color: var(--ink-faint);
  }
</style>
