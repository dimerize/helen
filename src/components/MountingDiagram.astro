---
/*
  A mounting elevation, drawn from the work's own proportions.

  This is the drawing an art handler works from: the piece in elevation, the
  floor, and the dimension from floor to the centre of the work. The centre
  is 57 inches, the museum standard, which is the same line the entry page
  and the wall are built on.

  It is generated, not decorative — change a work's ratio and the drawing
  changes with it.
*/

import { HANGING_LINE_INCHES } from '../data/site';

interface Props {
  /** Width ÷ height. */
  ratio: number;
  /** Printed against the width leader, when it is known. */
  dimensions?: string;
}

const { ratio, dimensions }: Props = Astro.props;

const W = 300;
const H = 200;
const FLOOR = 176;
const CENTRE = 78; // y of the 57" line

// Fit the work inside the drawing while keeping its true proportion.
const MAX_W = 150;
const MAX_H = 88;
const w = ratio >= MAX_W / MAX_H ? MAX_W : MAX_H * ratio;
const h = ratio >= MAX_W / MAX_H ? MAX_W / ratio : MAX_H;

const x = 118;
const y = CENTRE - h / 2;

const label = `Mounting elevation. The work is hung with its centre ${HANGING_LINE_INCHES} inches above the floor.`;
---

<figure class="diagram">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label} class="diagram__svg">
    <!-- Floor, with the hatching that means "ground" on a drawing -->
    <path d={`M8 ${FLOOR}H${W - 8}`} class="s" />
    {
      Array.from({ length: 22 }, (_, i) => (
        <path d={`M${12 + i * 13} ${FLOOR + 8}l6-8`} class="s s--faint" />
      ))
    }

    <!-- The 57" centre line, running back to the dimension -->
    <path d={`M40 ${CENTRE}H${x + w + 22}`} class="s s--dash" />

    <!-- The work -->
    <rect x={x} y={y} width={w} height={h} class="s" fill="none" />
    <path d={`M${x} ${y}l${w} ${h}M${x + w} ${y}l${-w} ${h}`} class="s s--ghost" />

    <!-- Vertical dimension: floor to centre -->
    <path d={`M40 ${CENTRE}V${FLOOR}`} class="s" />
    <path d={`M36 ${CENTRE + 5}l4-5 4 5`} class="s" />
    <path d={`M36 ${FLOOR - 5}l4 5 4-5`} class="s" />
    <text x="32" y={(CENTRE + FLOOR) / 2 + 4} text-anchor="end" class="t">
      {HANGING_LINE_INCHES}&#8221;
    </text>

    <!-- Horizontal dimension across the work -->
    <path d={`M${x} ${y - 14}H${x + w}`} class="s s--faint" />
    <path d={`M${x + 5} ${y - 18}l-5 4 5 4`} class="s s--faint" />
    <path d={`M${x + w - 5} ${y - 18}l5 4-5 4`} class="s s--faint" />
    {dimensions && (
      <text x={x + w / 2} y={y - 22} text-anchor="middle" class="t t--faint">
        {dimensions}
      </text>
    )}
  </svg>

  <figcaption class="meta diagram__cap">Mounting elevation</figcaption>
</figure>

<style>
  .diagram {
    display: grid;
    gap: 0.75rem;
    max-width: 22rem;
  }

  .diagram__svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .s {
    stroke: var(--ink-muted);
    stroke-width: 1;
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .s--faint {
    stroke: var(--ink-faint);
  }

  /* The crossed diagonals that mark a plane on an elevation. */
  .s--ghost {
    stroke: var(--line);
  }

  .s--dash {
    stroke: var(--ink-faint);
    stroke-dasharray: 5 4;
  }

  .t {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    fill: var(--ink-muted);
  }

  .t--faint {
    fill: var(--ink-faint);
  }

  .diagram__cap {
    color: var(--ink-faint);
  }
</style>
