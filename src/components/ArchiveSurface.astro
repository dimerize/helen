<section id="archive-surface" hidden>
  <div id="archive-room-view" role="img" aria-label="Archive room. Scans hang on the walls, rest on a workbench, and lie on the floor. Drag an image to move it. Pinch or scroll to look closer."></div>

  <a class="skip" href="#archive">Skip to archive</a>
  <header class="site-header">
    <a class="wordmark" href="/">Helen Zhang</a>
    <nav aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/archive" aria-current="page">Archive</a>
      <a href="/gallery">Gallery</a>
    </nav>
  </header>
  <noscript><p style="padding:24px">For the interactive image views, enable JavaScript. You can also <a href="/work">browse selected work</a>.</p></noscript>
  <main id="archive" data-spatial-stage>
    <section class="archive-intro" aria-labelledby="page-title">
      <h1 id="page-title">Archive</h1>
      <div class="intro-right"><div class="view-switch" aria-label="Archive view" role="group"><button type="button" data-view="room" aria-pressed="true">Room</button><button type="button" data-view="index" aria-pressed="false">Index</button></div></div>
    </section>
    <div class="room-toolbar">
      <p id="room-hint" class="visually-hidden">Drag to move. Open to inspect.</p>
      <div class="arrange-tools" role="group" aria-label="Archive room controls" aria-describedby="room-hint"><button type="button" id="spread" aria-pressed="true">Reset room</button><button type="button" id="gather" aria-pressed="false">By project</button><button type="button" id="move-images" aria-pressed="false">Move images</button></div>
    </div>
    <div class="index-toolbar" hidden>
      <div class="filters" role="group" aria-label="Filter archive">
        <button type="button" data-filter="all" aria-pressed="true">Everything</button>
        <button type="button" data-filter="scans" aria-pressed="false">Scans</button>
        <button type="button" data-filter="material" aria-pressed="false">Material studies</button>
        <button type="button" data-filter="interpretations" aria-pressed="false">Interpretations</button>
      </div>
    </div>
    <div class="room" id="room" data-arrangement="spread"><div id="project-markers" class="project-markers"></div><div class="image-space" id="image-space" aria-label="Archive images"></div></div>
    <p id="archive-status" class="visually-hidden" role="status" aria-live="polite"></p>
    <p id="move-instructions" class="visually-hidden">Press Enter to inspect an image. Hold Alt and use the arrow keys to move it on its surface. Drag the empty room to look around; pinch or scroll to look closer.</p>
    <noscript><p>Please enable JavaScript for the image room. <a href="/project?work=thesis">Explore the thesis project.</a></p></noscript>
    <footer class="archive-footer"><a href="/work">Selected work <span class="ui-icon icon-arrow-up-right" aria-hidden="true"></span></a></footer>
  </main>
  <dialog id="image-dialog" aria-labelledby="detail-title" aria-describedby="detail-caption">
    <div class="detail-layout">
      <div class="detail-picture"><img id="detail-image" src="/artwork/train-scan-wide.webp" alt=""><div id="detail-lens" class="detail-lens" aria-hidden="true"></div><button type="button" id="magnify-image" aria-pressed="false" aria-describedby="magnify-hint"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6.5"></circle><path d="m15 15 6 6"></path></svg><span>Magnify image</span></button><p id="magnify-hint" class="visually-hidden" hidden>Move across the image to magnify it.</p></div>
      <div class="detail-panel">
        <button class="close-dialog" type="button" aria-label="Close image">Close <span class="ui-icon icon-close" aria-hidden="true"></span></button>
        <div class="detail-copy"><p id="detail-type"></p><h2 id="detail-title"></h2><p id="detail-caption"></p><a id="explore-scan" class="explore-scan" href="/?scan=train-scan&amp;explore=1" hidden>Step inside this scan <span class="ui-icon icon-arrow-up-right" aria-hidden="true"></span></a><a id="related-link" href="/project?work=standing">View project <span class="ui-icon icon-arrow-up-right" aria-hidden="true"></span></a></div>
        <div class="detail-connections"><p id="connections-label">Related images</p><div id="related-images" class="related-images" aria-labelledby="connections-label"></div><button type="button" id="gather-family">Highlight this project <span class="ui-icon icon-arrow-down" aria-hidden="true"></span></button></div>
        <div class="detail-pagination"><button id="previous-image" type="button" aria-label="Previous image"><span class="ui-icon icon-arrow-left" aria-hidden="true"></span></button><span id="detail-position" aria-live="polite"></span><button id="next-image" type="button" aria-label="Next image"><span class="ui-icon icon-arrow-right" aria-hidden="true"></span></button></div>
      </div>
    </div>
  </dialog>

</section>
