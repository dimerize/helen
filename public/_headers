# Cloudflare Pages reads this file and applies these headers at the edge.

# Astro fingerprints everything in /_astro/ with a content hash, so these
# files can never change under a given name. Cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are versioned by hand rather than hashed, so a month is the safe
# ceiling — long enough that repeat visits never refetch 52 kB.
/fonts/*
  Cache-Control: public, max-age=2592000
  Access-Control-Allow-Origin: *

/*.jpg
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800

# HTML is revalidated every time so a content update goes live immediately.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
